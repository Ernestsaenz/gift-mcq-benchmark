# Copy to `.env` and fill in. `.env` is gitignored — never commit real credentials.
#
# NONE of these are needed to verify the committed results. The offline path
# (`make verify`, `make test`, the SQL queries in README.md) reads only the
# committed database. Credentials are required solely to run the benchmark LIVE
# against models, which costs money and produces a NEW experiment rather than
# reproducing the committed one.

# --- OpenRouter arm -------------------------------------------------------
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# --- GIFT arm (the retrieval-augmented system under test) -----------------
# Requires a reachable GIFT deployment. Without one, only the `openrouter`
# arm can be reproduced live.
GIFT_API=https://your-gift-deployment.example.com
GIFT_EMAIL=you@example.com
GIFT_PASSWORD=

# --- Output database ------------------------------------------------------
# Where live runs are written. Keep this under runs/ (gitignored).
# NEVER point this at data/medrag_eval.sqlite — that is the committed
# ground-truth artifact and must stay immutable.
MEDRAG_EVAL_DB=./runs/medrag_eval.sqlite
